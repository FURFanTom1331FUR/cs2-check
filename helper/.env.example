# Скопируйте в .env (этот файл не попадает в git) и заполните при необходимости.

# Режим: boiler (по умолчанию — через ваш запущенный клиент Steam, без паролей)
#        bot    (отдельный Steam-аккаунт; нужны три переменные ниже)
HELPER_BACKEND=boiler

# --- только для режима bot: ОТДЕЛЬНЫЙ аккаунт, не ваш основной ---
BOT_STEAM_LOGIN=
BOT_STEAM_PASSWORD=
# shared_secret из мобильного аутентификатора (maFile SDA/steamguard-cli); без него код Steam Guard спросят в консоли
BOT_STEAM_SHARED_SECRET=

# Порт менять не нужно: сайт ищет помощника на 27901
# HELPER_PORT=27901
